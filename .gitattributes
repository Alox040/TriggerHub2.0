# Normalize line endings to LF in the repository
* text=auto eol=lf

*.cjs   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.txt   text eol=lf
*.js    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.env   text eol=lf

# Binary files — no line ending conversion
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.exe   binary
*.zip   binary
*.node  binary
